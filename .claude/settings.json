{
  "permissions": {
    "allow": [
      "Bash(php -l:*)",
      "Bash(node --check:*)",
      "Bash(python3 tools/i18n-audit.py:*)",
      "Bash(bash tools/bump-version.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.sh\""
          }
        ]
      }
    ]
  }
}
