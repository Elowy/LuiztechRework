# ---- Luiz-Tech backend környezeti változók ----
# Másold .env néven, és töltsd ki éles deploynál.

# A szerver portja (a legtöbb hosting maga állítja be)
PORT=3000

# Állandó titok a session tokenek aláírásához.
# FONTOS: éles környezetben MINDENKÉPP állítsd be egy hosszú, véletlen értékre,
# különben minden újraindításkor kilépteti az admint.
# Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kezdeti admin belépési adatok (csak az adatbázis ELSŐ létrehozásakor érvényes).
# Utána az admin felület „Fiók" menüjében módosíthatók.
ADMIN_USER=admin
ADMIN_PASS=luiztech

# Az adatfájl mappája (alapértelmezett: ./data)
# DATA_DIR=/var/data

# Production mód
NODE_ENV=production
