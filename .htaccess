# ---- Luiz-Tech (PHP backend) ----
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Minden /api/* kérés a PHP routerhez
  RewriteRule ^api/?$ api/index.php [QSA,L]
  RewriteRule ^api/.*$ api/index.php [QSA,L]
</IfModule>

# A DB-konfig és az adat-fájlok közvetlen elérésének tiltása
<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>

# Biztonsági fejlécek (minden válaszra)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # A HTML mindig friss legyen (ne ragadjon be régi tartalom a böngészőben/proxy-ban)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # A verziózott (?v=) statikus fájlok hosszan gyorsítótárazhatók
  <FilesMatch "\.(css|js|svg|png|jpe?g|gif|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
# (A PHP futtatás tiltása az uploads mappában az uploads/.htaccess-ben van.)
